{
  "name": "rrh-ems",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node apps/api/dist/server.js",
    "postinstall": "prisma generate --schema=apps/api/prisma/schema.prisma",
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspace=apps/api",
    "build:all": "npm run build --workspaces --if-present",
    "prepare": "node -e \"if (process.env.CI || process.env.NODE_ENV === 'production') process.exit(0); require('child_process').execSync('husky', {stdio: 'inherit'})\"",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prisma:seed": "ts-node apps/api/prisma/seed.ts",
    "test:api": "jest --config jest.config.js --runInBand",
    "test:e2e": "playwright test",
    "db:push:test": "ts-node scripts/push-test-db.ts",
    "db:push:test-local": "node scripts/push-test-db-local.js"
  },
  "prisma": {
    "seed": "ts-node apps/api/prisma/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.12.7",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/supertest": "^6.0.2",
    "bcryptjs": "^2.4.3",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.2.5",
    "prisma": "^5.12.1",
    "sharp": "^0.35.4",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "5.4.5"
  },
  "dependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.12.7",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/supertest": "^6.0.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.0.0",
    "express": "^4.19.2",
    "jest": "^29.7.0",
    "openai": "^7.4.0",
    "prettier": "^3.2.5",
    "prisma": "^5.12.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "5.4.5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
