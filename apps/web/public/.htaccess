<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Without this, index.html and sw.js had no explicit cache headers at all,
# so the host's default static-file caching could serve a stale index.html
# (referencing JS chunk filenames a later deploy already deleted) to a
# brand-new visitor, not just an already-open tab -- the exact
# "Failed to fetch dynamically imported module" crash reported in
# production. index.html/sw.js must always be revalidated; the hashed
# assets/* files are safe to cache forever since a new build always gets a
# new filename, never reuses one.
<IfModule mod_headers.c>
  # Order matters: mod_headers applies "Header set" directives in the order
  # Apache encounters them, and the last match for a given header wins.
  # Since sw.js matches both patterns below, the no-cache rule for
  # index.html/sw.js must come AFTER the generic immutable-cache rule, or
  # it would be silently overridden back to a 1-year cache.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|sw\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
